# OFFROU 계정·동기화 (선택 기능)
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. 실제 값이 든 파일은 Git에 올리지 않는다.
# 비워두면 계정 기능만 꺼지고, 비회원 OFFROU는 그대로 동작한다.
#
# Supabase 대시보드 → Project Settings → API
#   - Project URL
#   - anon / publishable 키 (공개용 키. RLS로 보호된다)
# ⚠️ service_role / secret 키는 절대 넣지 않는다.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 공식 홈페이지 SEO (선택). 실제 배포 주소·공유 이미지가 정해지면 채운다. 비워두면 canonical·og:url·og:image를 넣지 않는다.
# VITE_OG_IMAGE: 절대 URL 또는 /public 기준 경로 (예: /og/offrou-1200x630.png — 1200×630 권장)
VITE_SITE_URL=
VITE_OG_IMAGE=
